# Optional Gemini API key. Leave blank to use rule-based summaries.
GEMINI_API_KEY=

# Optional MongoDB connection string. SQLite works without this.
MONGODB_URI=
MONGODB_DATABASE=insurance_claims

# Windows example; update if Tesseract is installed elsewhere.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

MAX_UPLOAD_MB=15
